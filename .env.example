# ============================================================
# 环境变量模板：复制为 .env 后填写（.env 禁止提交，见 CONTRIBUTING）
# 本文件与 docs/架构设计.md 第 9.5 节同步维护
# ============================================================

# ---------- LLM（DeepSeek） ----------
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-在此填写你的Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---------- Embedding（默认本地；可切在线） ----------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
# 在线 Embedding 时才需要（EMBEDDING_PROVIDER=siliconflow / dashscope）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DASHSCOPE_API_KEY=

# ---------- Rerank（第3周启用） ----------
RERANK_ENABLED=false
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 检索与生成 ----------
RETRIEVE_K=20
TOP_K=5
SCORE_THRESHOLD=0.35
MAX_CONTEXT_TOKENS=3000
ANSWER_MAX_CHARS=200

# ---------- 切片（第2周） ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_CHUNK_CHARS=80
EXCEL_ROWS_PER_CHUNK=20

# ---------- 存储路径 ----------
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=enterprise_kb
UPLOAD_DIR=./data/uploads
SQLITE_PATH=./data/app.db

# ---------- 上传限制 ----------
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_UPLOAD=5

# ---------- 服务 ----------
API_HOST=127.0.0.1
API_PORT=8000
WEB_API_BASE=http://127.0.0.1:8000
LOG_LEVEL=INFO
DEMO_MODE=false
